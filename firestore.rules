rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validItem(d, key) {
      return d.keys().hasAll(['id', 'type', 'title', 'poster', 'year', 'status', 'rating', 'note', 'updatedAt'])
        && d.keys().hasOnly(['id', 'type', 'title', 'poster', 'year', 'status', 'rating', 'note', 'updatedAt', 'season', 'episode'])
        && d.id is int && d.id > 0 && d.id <= 9007199254740991
        && d.type in ['movie', 'tv'] && key == d.type + '-' + string(d.id)
        && d.title is string && d.title.size() <= 500
        && d.poster is string && d.poster.size() <= 2048
        && (d.poster == '' || d.poster.matches('https://image[.]tmdb[.]org/.*'))
        && d.year is string && d.year.size() <= 10
        && d.status in ['watchlist', 'watching', 'watched', 'dropped']
        && (d.rating == null || (d.rating is number && d.rating >= 1 && d.rating <= 10))
        && d.note is string && d.note.size() <= 5000
        // Numeric timestamps remain compatible with the previous deployed client.
        && (d.updatedAt is timestamp || d.updatedAt is number)
        && (!('season' in d) || (d.season is int && d.season >= 0))
        && (!('episode' in d) || (d.episode is int && d.episode >= 0));
    }
    // A game in the owner's collection; the key is the IGDB id.
    function validGame(d, key) {
      return d.keys().hasAll(['id', 'title', 'cover', 'year', 'genre', 'platforms', 'status', 'rating', 'note', 'hours', 'updatedAt'])
        && d.keys().hasOnly(['id', 'title', 'cover', 'year', 'genre', 'platforms', 'status', 'rating', 'note', 'hours', 'updatedAt', 'steam'])
        && d.id is int && d.id > 0 && d.id <= 9007199254740991 && key == string(d.id)
        && d.title is string && d.title.size() <= 500
        && d.cover is string && d.cover.size() <= 2048
        && (d.cover == '' || d.cover.matches('https://(images[.]igdb[.]com|[a-z0-9.-]+[.]steamstatic[.]com)/.*'))
        && d.year is string && d.year.size() <= 10
        && d.genre is string && d.genre.size() <= 100
        && d.platforms is list && d.platforms.size() <= 4
        && d.platforms.hasOnly(['pc', 'playstation', 'xbox', 'nintendo'])
        && d.status in ['want', 'playing', 'played', 'dropped', 'owned']
        && (d.rating == null || (d.rating is number && d.rating >= 1 && d.rating <= 10))
        && d.note is string && d.note.size() <= 5000
        && (d.hours == null || (d.hours is number && d.hours >= 0 && d.hours <= 100000))
        && (d.updatedAt is timestamp || d.updatedAt is number)
        && (!('steam' in d) || validSteamPlay(d.steam));
    }
    function validSteamPlay(s) {
      return s is map
        && s.keys().hasOnly(['appId', 'minutes', 'recent', 'lastPlayed'])
        && s.appId is int && s.appId > 0
        && s.minutes is int && s.minutes >= 0
        && s.recent is int && s.recent >= 0
        && s.lastPlayed is int && s.lastPlayed >= 0;
    }
    function validPerson(d) {
      return d.name is string && d.name.size() <= 100
        && d.picture is string && d.picture.size() <= 2048;
    }
    // A friend's copy of a library entry: no notes, numeric timestamps only.
    function validShared(d, key) {
      return d.keys().hasAll(['id', 'type', 'title', 'poster', 'year', 'status', 'rating', 'updatedAt'])
        && d.keys().hasOnly(['id', 'type', 'title', 'poster', 'year', 'status', 'rating', 'updatedAt', 'season', 'episode'])
        && d.id is int && d.id > 0 && d.id <= 9007199254740991
        && d.type in ['movie', 'tv'] && key == d.type + '-' + string(d.id)
        && d.title is string && d.title.size() <= 500
        && d.poster is string && d.poster.size() <= 2048
        && (d.poster == '' || d.poster.matches('https://image[.]tmdb[.]org/.*'))
        && d.year is string && d.year.size() <= 10
        && d.status in ['watchlist', 'watching', 'watched', 'dropped']
        && (d.rating == null || (d.rating is number && d.rating >= 1 && d.rating <= 10))
        && d.updatedAt is number
        && (!('season' in d) || (d.season is int && d.season >= 0))
        && (!('episode' in d) || (d.episode is int && d.episode >= 0));
    }
    // The owner has added the reader as a friend.
    function sharesWith(owner) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(owner)/friends/$(request.auth.uid));
    }
    // Public name card for invite links; readable by ID only, never listed.
    match /profiles/{uid} {
      allow get: if request.auth != null;
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['name', 'picture', 'updatedAt'])
        && validPerson(request.resource.data)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if owns(uid);
      match /ratings/{key} {
        allow read: if owns(uid) || sharesWith(uid);
        allow create, update: if owns(uid) && validShared(request.resource.data, key);
        allow delete: if owns(uid);
      }
    }
    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'picture', 'updatedAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.name is string && request.resource.data.name.size() <= 500
        && request.resource.data.picture is string && request.resource.data.picture.size() <= 2048
        && (request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is number);
      allow delete: if owns(uid);
      match /library/{key} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && validItem(request.resource.data, key);
      }
      match /games/{key} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && validGame(request.resource.data, key);
      }
      // Accounts linked to the profile; only Steam for now.
      match /links/{kind} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && kind == 'steam'
          && request.resource.data.keys().hasOnly(['steamId', 'name', 'avatar', 'linkedAt', 'syncedAt'])
          && request.resource.data.steamId is string
          && request.resource.data.steamId.matches('[0-9]{17}')
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 2048
          && request.resource.data.linkedAt is timestamp
          && (!('syncedAt' in request.resource.data) || request.resource.data.syncedAt is timestamp);
      }
      // People the owner shares ratings with.
      match /friends/{friend} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && friend != uid
          && request.resource.data.keys().hasOnly(['name', 'picture', 'since'])
          && validPerson(request.resource.data)
          && request.resource.data.since is timestamp;
        // Someone with the owner's invite link adds themselves.
        allow create, update: if owns(friend) && friend != uid
          && request.resource.data.keys().hasOnly(['name', 'picture', 'since', 'invite'])
          && validPerson(request.resource.data)
          && request.resource.data.since is timestamp
          && request.resource.data.invite is string
          && request.resource.data.invite.matches('[A-Za-z0-9]{24}')
          && exists(/databases/$(database)/documents/users/$(uid)/invites/$(request.resource.data.invite));
      }
      // Invite keys in the owner's links; only the owner sees them.
      match /invites/{token} {
        allow read, delete: if owns(uid);
        allow create: if owns(uid) && token.matches('[A-Za-z0-9]{24}')
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt is timestamp;
      }
      // Friend requests: anyone signed in may ask once in their own name.
      match /requests/{from} {
        allow read: if owns(uid);
        allow delete: if owns(uid) || owns(from);
        allow create: if owns(from) && from != uid
          && request.resource.data.keys().hasOnly(['name', 'picture', 'createdAt'])
          && validPerson(request.resource.data)
          && request.resource.data.createdAt is timestamp;
      }
    }
  }
}
